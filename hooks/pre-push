#!/bin/sh
set -eu

remote_name=${1:-origin}
zero=0000000000000000000000000000000000000000
repo_root=$(git rev-parse --show-toplevel)

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is required but was not found in PATH" >&2
  exit 1
fi

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    log_opts="$local_sha --not --remotes=$remote_name"
  else
    if ! git -C "$repo_root" cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
      echo "Push blocked: remote commit $remote_sha is not present locally." >&2
      echo "Fetch $remote_name, reconcile the branch, and push again." >&2
      exit 1
    fi
    log_opts="$remote_sha..$local_sha"
  fi

  echo "GitLeaks: scanning $local_ref -> $remote_ref" >&2
  if ! gitleaks git "$repo_root" --no-banner --redact --log-opts="$log_opts"; then
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo "Push blocked: GitLeaks found a potential secret." >&2
  exit "$status"
fi
